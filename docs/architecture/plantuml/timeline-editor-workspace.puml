@startuml TimelineEditorWorkspace
title Dionysus Timeline Editor - Workspace Boundaries
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Project Shell" {
  [Module Navigation] as Nav
  [Storyboard] as Storyboard
  [References] as References
}
package "Timeline Editor Workspace" {
  [Source Browser\nMedia / Audio / Text / Effects / Transitions] as Source
  [Preview / Canvas] as Preview
  [Multitrack Timeline] as Timeline
  [Contextual Inspector] as Inspector
  [Contextual Action Bar] as ActionBar
  [Transport Controls] as Transport
}
package "Editing Core" {
  [Typed Edit Commands] as Commands
  [Command Validation] as Validation
  [Canonical Composition Store] as Store
  [Undo / Redo History] as History
  [Composition Renderer] as Renderer
}

Nav --> Source : open Editor
Nav --> Storyboard
Nav --> References
Storyboard ..> Source : explicit insert / assemble
References ..> Source : choose referenced assets
Source --> Commands : insert source
Timeline --> Commands : edit placement / track
Preview --> Commands : transform selection
Inspector --> Commands : property change
ActionBar --> Commands : contextual action
Transport --> Timeline : playhead / playback
Commands --> Validation
Validation --> Store : valid transaction
Validation --> History : record inverse
Store --> Renderer : revision changed
Renderer --> Preview : rendered frame
History --> Commands : undo / redo command
Timeline --> Inspector : selected entity
Timeline --> ActionBar : capabilities
@enduml
